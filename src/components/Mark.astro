---
// The Shalal Beirut badge (tap, cedar and water). Built by brand/tools/build-logo-v2-assets.mjs.
// On dark backgrounds pass `dark` to sit it on a white disc so the silver ring stays visible.
interface Props { class?: string; title?: string; dark?: boolean; }
const { class: cls, title, dark = false } = Astro.props;
---
<img class:list={['mark', cls, { 'mark-dark': dark }]} src="/logo.webp" width="256" height="256" alt={title ?? ''} decoding="async" />
