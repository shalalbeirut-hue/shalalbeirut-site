---
// Small shared blocks, picked by `kind` so pages stay short.
import Icon from './Icon.astro';
import { SERVICES } from '../data/services';
import { AREAS } from '../data/areas';
import { PRINCIPLES, STEPS } from '../data/content';
import { type Lang, href, UI, waLink } from '../i18n';
interface Props { kind: 'services' | 'principles' | 'steps' | 'areas' | 'cta'; lang: Lang; exclude?: string; }
const { kind, lang, exclude } = Astro.props;
const t = UI[lang];
const ar = lang === 'ar';
---
{kind === 'services' && (
  <div class="svc-grid">
    {SERVICES.filter((s) => s.slug !== exclude).map((s) => {
      const from = s.prices.map((p) => p.from).filter((v): v is number => v != null);
      const min = from.length ? Math.min(...from) : null;
      return (
        <article class="svc">
          <div class="svc-top">
            <span class="svc-icon"><Icon name={s.icon} /></span>
            <span class="svc-price">{min != null ? <>{t.fromPrice} <b>{min} {t.kd}</b></> : (ar ? 'السعر بعد المعاينة' : 'Priced after inspection')}</span>
          </div>
          <h3><a class="svc-title" href={href(lang, `/services/${s.slug}/`)}>{s[lang].name}</a></h3>
          <p class="svc-desc">{s[lang].short}</p>
          <ul class="svc-tags">{s[lang].includes.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
          <div class="svc-foot">
            <a class="svc-btn svc-btn-wa" href={waLink(`${t.waHello}: ${s[lang].name}`)}><Icon name="whatsapp" />{ar ? 'اطلبها الحين' : 'Request'}</a>
            <a class="svc-btn svc-btn-more" href={href(lang, `/services/${s.slug}/`)} aria-label={`${t.learnMore}: ${s[lang].name}`}>{t.learnMore}<Icon name="arrow" class="dir-arrow" /></a>
          </div>
        </article>
      );
    })}
  </div>
)}

{kind === 'principles' && (
  <div class="grid grid-3">
    {PRINCIPLES[lang].map((p) => (
      <div class="principle">
        <div class="icon-badge"><Icon name={p.icon} /></div>
        <div><h3>{p.t}</h3><p class="muted">{p.d}</p></div>
      </div>
    ))}
  </div>
)}

{kind === 'steps' && (
  <ol class="steps">
    {STEPS[lang].map((s, i) => (
      <li><span class="n">{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>
    ))}
  </ol>
)}

{kind === 'areas' && (
  <ul class="areas">
    {AREAS.map((a) => (
      <li><a href={href(lang, `/areas/${a.slug}/`)}><Icon name="pin" /><span><b>{a[lang].name}</b><small>{a[lang].places.slice(0, 4).join(ar ? '، ' : ', ')}</small></span></a></li>
    ))}
  </ul>
)}

{kind === 'cta' && (
  <section class="cta-band">
    <div class="container cta-inner">
      <div>
        <h2>{ar ? 'عندك عطل؟ صوّره وطرشه لنا' : 'Got a problem? Send us a photo'}</h2>
        <p>{ar ? 'نرد عليك بموعد وسعر تقريبي. في الموعد.. وبالضمان.' : 'We reply with a time slot and an estimate. On time, guaranteed.'}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-light" href={waLink(t.waHello)}><Icon name="whatsapp" />{t.bookWa}</a>
        <a class="btn btn-ghost-light" href={href(lang, '/contact/') + '#request'}>{ar ? 'نموذج الطلب' : 'Request form'}</a>
      </div>
    </div>
  </section>
)}

<style>
  .svc-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .svc { position: relative; display: flex; flex-direction: column; gap: 12px; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 24px; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; }
  .svc:hover { border-color: #a9c8b6; box-shadow: 0 16px 36px rgba(15, 42, 31, 0.1); transform: translateY(-3px); }
  .svc-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .svc-icon { width: 60px; height: 60px; border-radius: 18px; display: grid; place-items: center; color: #fff; background: linear-gradient(145deg, var(--cedar), var(--deep)); position: relative; flex-shrink: 0; }
  .svc-icon::after { content: ''; position: absolute; inset-inline-end: -4px; top: -4px; width: 14px; height: 14px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--water); border: 2px solid #fff; }
  .svc-icon :global(svg) { width: 30px; height: 30px; }
  .svc-price { font-size: 0.85rem; color: var(--slate); background: var(--mist); border-radius: 999px; padding: 4px 12px; white-space: nowrap; }
  .svc-price b { color: var(--cedar); font-family: var(--f-latin); }
  .svc h3 { font-size: 1.3rem; }
  .svc-title { color: inherit; text-decoration: none; }
  .svc-title::after { content: ''; position: absolute; inset: 0; border-radius: 20px; }
  .svc-desc { color: var(--slate); }
  .svc-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .svc-tags li { font-size: 0.82rem; color: var(--cedar); background: var(--cedar-050); border-radius: 8px; padding: 3px 10px; }
  .svc-foot { margin-top: auto; padding-top: 14px; display: flex; gap: 10px; }
  .svc-btn { position: relative; z-index: 1; flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; border-radius: 12px; font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: background 0.15s, color 0.15s; }
  .svc-btn :global(svg) { width: 18px; height: 18px; }
  .svc-btn-wa { background: var(--cedar); color: #fff; }
  .svc-btn-wa:hover { background: var(--cedar-600); color: #fff; }
  .svc-btn-more { background: var(--mist); color: var(--cedar); }
  .svc-btn-more:hover { background: var(--cedar-050); color: var(--cedar); }
  @media (prefers-reduced-motion: reduce) { .svc:hover { transform: none; } }
  :global(html[dir='rtl'] .dir-arrow) { transform: scaleX(-1); }

  .principle { display: flex; gap: 16px; align-items: flex-start; padding: 6px 0; }
  .principle h3 { margin-bottom: 4px; }

  .steps { list-style: none; padding: 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); counter-reset: s; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
  .steps .n { width: 44px; height: 44px; border-radius: 50%; background: var(--cedar); color: #fff; display: grid; place-items: center; font-family: var(--f-latin); font-weight: 600; font-size: 1.2rem; flex-shrink: 0; }
  .steps h3 { margin-bottom: 4px; }
  .steps p { color: var(--slate); }

  .areas { list-style: none; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .areas a { display: flex; gap: 12px; align-items: flex-start; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: #fff; text-decoration: none; color: var(--ink); }
  .areas a:hover { border-color: var(--cedar); }
  .areas :global(svg) { width: 22px; height: 22px; color: var(--water); flex-shrink: 0; margin-top: 3px; }
  .areas span { display: flex; flex-direction: column; }
  .areas b { color: var(--cedar); font-size: 1.08rem; }
  .areas small { color: var(--slate); font-size: 0.9rem; }

  .cta-band { background: var(--cedar); color: #e3f0e8; padding-block: 44px; }
  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta-band h2 { color: #fff; }
  .cta-band p { margin-top: 6px; }
</style>
