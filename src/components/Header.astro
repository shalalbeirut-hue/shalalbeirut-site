---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { type Lang, href, UI, waLink } from '../i18n';
interface Props { lang: Lang; path: string; }
const { lang, path } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const links = [
  ['/services/', t.nav.services],
  ['/prices/', t.nav.prices],
  ['/areas/', t.nav.areas],
  ['/reviews/', t.nav.reviews],
  ['/contracts/', t.nav.contracts],
  ['/contact/', t.nav.contact],
];
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href(lang, '/')} aria-label={t.siteName}>
      <Mark class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">{lang === 'ar' ? 'شلال بيروت' : 'Shalal Beirut'}</span>
        <span class="brand-sub">{lang === 'ar' ? 'للأدوات الصحية وصيانتها' : 'Sanitary Ware & Maintenance'}</span>
      </span>
    </a>
    <nav class="nav" aria-label={lang === 'ar' ? 'القائمة الرئيسية' : 'Main menu'}>
      {links.map(([p, label]) => <a href={href(lang, p)} aria-current={current(p)}>{label}</a>)}
    </nav>
    <div class="actions">
      <a class="lang" href={href(other, path)} hreflang={other} lang={other}><Icon name="globe" />{t.langSwitch}</a>
      <a class="btn btn-primary wa" href={waLink(t.waHello)}><Icon name="whatsapp" /><span>{t.bookWa}</span></a>
      <details class="menu">
        <summary aria-label={lang === 'ar' ? 'القائمة' : 'Menu'}><Icon name="menu" /></summary>
        <div class="menu-panel">
          {links.map(([p, label]) => <a href={href(lang, p)} aria-current={current(p)}>{label}</a>)}
          <a href={href(other, path)} hreflang={other} lang={other}>{t.langSwitch}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--cedar); flex-shrink: 0; }
  :global(.brand-mark) { width: 40px; height: 44px; flex-shrink: 0; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; white-space: nowrap; }
  .brand-name { font-family: var(--f-display); font-weight: 700; font-size: 1.35rem; }
  :global(html[lang='en']) .brand-name { font-family: var(--f-latin); font-weight: 600; font-size: 1.15rem; letter-spacing: 0.02em; }
  .brand-sub { font-size: 0.72rem; color: var(--slate); }
  .nav { display: flex; gap: 4px; margin-inline-start: auto; }
  .nav a { text-decoration: none; color: var(--ink); padding: 8px 10px; border-radius: 8px; font-weight: 500; font-size: 0.97rem; }
  .nav a:hover { background: var(--mist); color: var(--cedar); }
  .nav a[aria-current='page'] { color: var(--cedar); box-shadow: inset 0 -2px 0 var(--cedar); border-radius: 0; }
  .actions { display: flex; align-items: center; gap: 10px; }
  .lang { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--slate); font-size: 0.92rem; padding: 8px; }
  .lang :global(svg) { width: 18px; height: 18px; }
  .lang:hover { color: var(--cedar); }
  .wa { min-height: 44px; padding-inline: 18px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--line); color: var(--cedar); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary :global(svg) { width: 24px; height: 24px; }
  .menu-panel { position: absolute; inset-inline-end: 0; top: 52px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 8px; display: flex; flex-direction: column; min-width: 220px; box-shadow: 0 12px 30px rgba(15, 42, 31, 0.12); }
  .menu-panel a { padding: 12px 14px; text-decoration: none; color: var(--ink); border-radius: 8px; }
  .menu-panel a:hover, .menu-panel a[aria-current='page'] { background: var(--mist); color: var(--cedar); }
  @media (max-width: 1080px) {
    .nav { display: none; }
    .actions { margin-inline-start: auto; }
    .menu { display: block; }
  }
  @media (max-width: 760px) {
    .wa, .lang { display: none; }
    .brand-sub { display: none; }
  }
</style>
