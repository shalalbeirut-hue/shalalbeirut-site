---
// Listing and single-topic pages that share one page frame.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Sections from '../components/Sections.astro';
import Blocks from '../components/Blocks.astro';
import RequestForm from '../components/RequestForm.astro';
import { SITE } from '../config';
import { SERVICES } from '../data/services';
import { CONTRACTS, FAQ } from '../data/content';
import { type Lang, href, UI, waLink, telLink, displayPhone, priceLabel } from '../i18n';

type Kind = 'services' | 'areas' | 'prices' | 'reviews' | 'contracts' | 'warranty' | 'about' | 'contact' | '404';
interface Props { lang: Lang; kind: Kind; }
const { lang, kind } = Astro.props;
const t = UI[lang];
const ar = lang === 'ar';
const w = SITE.warrantyMonths;
const warrantyText = w ? (ar ? `${w} شهور` : `${w} months`) : null;

const META: Record<Kind, { path: string; title: string; desc: string; h1: string; lead: string; label: string }> = {
  services: {
    path: '/services/', label: t.nav.services,
    title: ar ? 'خدمات فني صحي بالكويت | شلال بيروت' : 'Plumbing Services in Kuwait | Shalal Beirut',
    desc: ar ? 'كل خدمات شلال بيروت: كشف تسربات، تسليك مجاري، سباكة وتمديدات، سخانات، خزانات ومضخات، برادات مياه، وتركيب أدوات صحية.' : 'All Shalal Beirut services: leak detection, drain unclogging, plumbing, water heaters, tanks and pumps, water coolers and sanitary ware installation.',
    h1: ar ? 'خدماتنا' : 'Our services',
    lead: ar ? 'نصون ونركّب كل شي يخص الماي، في الموعد وبالضمان.' : 'Installation and maintenance for everything water-related, on time and guaranteed.',
  },
  areas: {
    path: '/areas/', label: t.nav.areas,
    title: ar ? 'مناطق الخدمة: فني صحي في كل محافظات الكويت | شلال بيروت' : 'Service Areas: Plumbers in Every Kuwait Governorate | Shalal Beirut',
    desc: ar ? 'نغطي محافظات الكويت الست: العاصمة، حولي، الفروانية، الأحمدي، الجهراء، ومبارك الكبير، بموعد وصول محدد.' : 'We cover all six governorates: Capital, Hawalli, Farwaniya, Ahmadi, Jahra and Mubarak Al-Kabeer, with a fixed arrival time.',
    h1: ar ? 'مناطق الخدمة' : 'Service areas',
    lead: ar ? 'فنيينا يوصلونك في كل محافظات الكويت. اختار محافظتك.' : 'Our technicians cover every governorate in Kuwait. Choose yours.',
  },
  prices: {
    path: '/prices/', label: t.nav.prices,
    title: ar ? 'أسعار فني صحي بالكويت | شلال بيروت' : 'Plumbing Prices in Kuwait | Shalal Beirut',
    desc: ar ? 'قائمة أسعار شلال بيروت لخدمات السباكة وكشف التسربات والتسليك والسخانات والخزانات والأدوات الصحية. أسعار واضحة وبدون رسوم مفاجئة.' : 'Shalal Beirut price list for plumbing, leak detection, drain unclogging, water heaters, tanks and sanitary ware. Clear prices, no surprise fees.',
    h1: ar ? 'قائمة الأسعار' : 'Price list',
    lead: ar ? 'هذي أسعار تبدأ من. السعر النهائي بعد المعاينة وقبل لا نبدأ، وما نشتغل إلا إذا وافقت. والقطع تنحسب بروحها بسعر المحل.' : 'Starting prices. The final price is agreed after inspection and before work. Parts are charged separately at shop prices.',
  },
  reviews: {
    path: '/reviews/', label: t.nav.reviews,
    title: ar ? 'آراء العملاء وتقييمات شلال بيروت' : 'Customer Reviews | Shalal Beirut',
    desc: ar ? 'آراء وتقييمات عملاء شلال بيروت الحقيقيين بعد كل زيارة: الخدمة، الفني، والالتزام بالموعد.' : 'Real customer reviews of Shalal Beirut after each visit: the service, the technician and punctuality.',
    h1: ar ? 'آراء العملاء' : 'Customer reviews',
    lead: ar ? 'بعد كل زيارة يوصلك استبيان قصير. ونحط هني بس الآراء اللي أصحابها وافقوا ننشرها.' : 'After every visit the customer receives a short survey. We publish the reviews customers agreed to share.',
  },
  contracts: {
    path: '/contracts/', label: t.nav.contracts,
    title: CONTRACTS[lang].title, desc: CONTRACTS[lang].desc, h1: CONTRACTS[lang].h1, lead: CONTRACTS[lang].intro,
  },
  warranty: {
    path: '/warranty/', label: ar ? 'سياسة الضمان' : 'Warranty policy',
    title: ar ? 'سياسة الضمان | شلال بيروت' : 'Warranty Policy | Shalal Beirut',
    desc: ar ? 'ضمان مكتوب على كل شغل من شلال بيروت، وكفالة المصنع على القطع من محلنا. تعرّف شنو يشمل الضمان وشلون تطلبه.' : 'A written warranty on every Shalal Beirut job, plus the manufacturer warranty on parts from our shop. What is covered and how to claim.',
    h1: ar ? 'سياسة الضمان' : 'Warranty policy',
    lead: ar ? 'كل شغل نسويه عليه ضمان مكتوب، يوصلك على الواتساب ويا الفاتورة.' : 'Every job comes with a written warranty, sent to you on WhatsApp with the invoice.',
  },
  about: {
    path: '/about/', label: ar ? 'من نحن' : 'About us',
    title: ar ? 'من نحن | شلال بيروت للأدوات الصحية وصيانتها' : 'About Us | Shalal Beirut Sanitary Ware & Maintenance',
    desc: ar ? 'شلال بيروت محل أدوات صحية وفريق صيانة في الكويت. وعدنا بسيط: في الموعد.. وبالضمان.' : 'Shalal Beirut is a sanitary ware shop and maintenance team in Kuwait. Our promise is simple: on time, guaranteed.',
    h1: ar ? 'من نحن' : 'About us',
    lead: ar ? 'محل أدوات صحية وفريق صيانة، تحت سقف واحد.' : 'A sanitary ware shop and a maintenance team under one roof.',
  },
  contact: {
    path: '/contact/', label: t.nav.contact,
    title: ar ? 'تواصل معنا واطلب فني صحي | شلال بيروت' : 'Contact Us and Book a Plumber | Shalal Beirut',
    desc: ar ? 'اطلب فني صحي على الواتساب أو بالاتصال أو من نموذج الطلب. محلنا في دوار الكرد، ونغطي كل مناطق الكويت.' : 'Book a plumber on WhatsApp, by phone or with the request form. Our shop is at Al-Kurd Roundabout and we cover all of Kuwait.',
    h1: ar ? 'تواصل معنا' : 'Contact us',
    lead: ar ? 'أسرع طريقة: صوّر المشكلة وطرشها لنا على الواتساب.' : 'The fastest way: take a photo of the problem and send it on WhatsApp.',
  },
  '404': {
    path: '/404/', label: '404',
    title: ar ? 'الصفحة غير موجودة | شلال بيروت' : 'Page Not Found | Shalal Beirut',
    desc: '', h1: ar ? 'الصفحة هذي مو موجودة' : 'This page does not exist',
    lead: ar ? 'يمكن الرابط تغيّر. جرّب الصفحة الرئيسية أو كلمنا على طول.' : 'The link may have changed. Try the home page or contact us directly.',
  },
};
const m = META[kind];
const trail: [string, string][] = [[t.home, '/'], [m.label, m.path]];
const priceLd = kind === 'prices' ? [{
  '@context': 'https://schema.org', '@type': 'OfferCatalog', name: m.h1, url: SITE.url + href(lang, '/prices/'),
  itemListElement: SERVICES.map((s) => ({ '@type': 'OfferCatalog', name: s[lang].name, itemListElement: s.prices.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p[lang] }, ...(p.from != null ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: p.from, priceCurrency: 'KWD' } } : {}) })) })),
}] : [];
---
<Base lang={lang} path={m.path} title={m.title} desc={m.desc} jsonld={priceLd} noindex={kind === '404'}>
  <div class="page-hero">
    <div class="container">
      {kind !== '404' && <Blocks kind="crumbs" lang={lang} trail={trail} />}
      <div class="inner">
        <h1>{m.h1}</h1>
        <p class="lead">{m.lead}</p>
        {(kind === 'contact' || kind === 'contracts' || kind === '404') && (
          <div class="btn-row">
            <a class="btn btn-primary" href={waLink(kind === 'contracts' ? (ar ? 'السلام عليكم، أبي عرض سعر لعقد صيانة' : 'Hello, I would like a maintenance contract quote') : t.waHello)}><Icon name="whatsapp" />{t.bookWa}</a>
            {kind === '404' ? <a class="btn btn-outline" href={href(lang, '/')}>{t.home}</a> : <a class="btn btn-outline" href={telLink()}><Icon name="phone" />{t.call}</a>}
          </div>
        )}
      </div>
    </div>
  </div>

  {kind === 'services' && <section class="section"><div class="container"><Sections kind="services" lang={lang} /></div></section>}

  {kind === 'areas' && <section class="section"><div class="container"><Sections kind="areas" lang={lang} /></div></section>}

  {kind === 'prices' && (
    <section class="section">
      <div class="container stack" style="gap:28px">
        {SERVICES.map((s) => (
          <div class="stack" style="gap:12px">
            <h2 class="h3"><a href={href(lang, `/services/${s.slug}/`)}>{s[lang].name}</a></h2>
            <div class="table-wrap">
              <table class="prices">
                <thead><tr><th scope="col">{ar ? 'الخدمة' : 'Job'}</th><th scope="col" class="num">{t.fromPrice}</th></tr></thead>
                <tbody>{s.prices.map((p) => <tr><td>{p[lang]}</td><td class="num">{priceLabel(lang, p.from)}</td></tr>)}</tbody>
              </table>
            </div>
          </div>
        ))}
        <p class="muted">{ar ? 'الأسعار بالدينار الكويتي، وما تشمل سعر القطع.' : 'Prices are in Kuwaiti dinars and exclude parts.'}</p>
      </div>
    </section>
  )}

  {kind === 'reviews' && <section class="section"><div class="container"><Blocks kind="reviews" lang={lang} /></div></section>}

  {kind === 'contracts' && (
    <section class="section">
      <div class="container grid grid-2">
        <div class="card"><h2 class="h3">{ar ? 'شنو يشمل العقد' : 'What the contract covers'}</h2><ul class="checklist">{CONTRACTS[lang].items.map((i) => <li>{i}</li>)}</ul></div>
        <div class="card"><h2 class="h3">{ar ? 'حق منو العقود؟' : 'Who it is for'}</h2><ul class="checklist">{CONTRACTS[lang].who.map((i) => <li>{i}</li>)}</ul></div>
      </div>
    </section>
  )}

  {kind === 'warranty' && (
    <section class="section">
      <div class="container prose">
        <h2>{ar ? 'مدة الضمان' : 'Warranty period'}</h2>
        <p>{ar ? 'مدة ضمان الشغل: ' : 'Workmanship warranty: '}{warrantyText ? <b>{warrantyText}</b> : <b>{ar ? 'حسب نوع الخدمة' : 'depends on the service'}</b>}{ar ? '، وتختلف حسب نوع الخدمة وتنكتب لك بالفاتورة.' : ', depending on the service, and written on your invoice.'}</p>
        <h2>{ar ? 'شنو يشمل الضمان' : 'What is covered'}</h2>
        <ul class="checklist">
          <li>{ar ? 'أي خلل بالشغل اللي سويناه خلال مدة الضمان، نرجع نصلحه ببلاش.' : 'Any fault in the work we did during the warranty period is fixed free of charge.'}</li>
          <li>{ar ? 'القطع اللي من محلنا عليها كفالة المصنع، وعليها ملصق ضمان برقم الطلب.' : 'Parts from our shop carry the manufacturer warranty and a warranty sticker with your order number.'}</li>
        </ul>
        <h2>{ar ? 'شنو ما يشمله' : 'What is not covered'}</h2>
        <ul class="checklist">
          <li>{ar ? 'سوء الاستخدام، أو إذا أحد ثاني عدّل على شغلنا.' : 'Misuse, or changes to our work by someone else.'}</li>
          <li>{ar ? 'القطع اللي جابها العميل، إلا إذا كان العيب في التركيب.' : 'Parts supplied by the customer, unless the fault is in the installation.'}</li>
        </ul>
        <h2>{ar ? 'شلون تطلب الضمان' : 'How to claim'}</h2>
        <p>{ar ? 'طرش لنا رقم الطلب أو صورة الفاتورة على الواتساب، ونحدد لك موعد.' : 'Send us your order number or a photo of the invoice on WhatsApp and we will book a visit.'}</p>
      </div>
    </section>
  )}

  {kind === 'about' && (
    <section class="section">
      <div class="container split">
        <div class="prose">
          <p>{ar ? 'بدينا بمحل أدوات صحية في دوار الكرد. كل يوم العملاء يسألونا: تعرفون فني نثق فيه؟ فقلنا خلنا نسوي الفريق بروحنا.' : 'We started as a sanitary ware shop at Al-Kurd Roundabout. Every day customers asked us for a technician they could trust, so we built that team ourselves.'}</p>
          <p>{ar ? 'الحين نبيع القطع ونركبها ونصونها، وكل شغل عليه ضمان مكتوب. ووعدنا بسيط وثابت: في الموعد.. وبالضمان.' : 'Today we sell the parts, install them and maintain them, and every job carries a written warranty. Our promise is simple: on time, guaranteed.'}</p>
          <p>{ar ? 'الاسم "شلال بيروت" يجمع شي من أصلنا، الأرزة اللبنانية، وشي من شغلنا، الماي. وهذا اللي تشوفه بشعارنا: أرزة من مواسير، وفوقها نقطة ماي.' : 'The name "Shalal Beirut" (Beirut Waterfall) joins our roots, the Lebanese cedar, with our work, water. That is our logo: a cedar made of pipes with a drop of water on top.'}</p>
        </div>
        <Sections kind="principles" lang={lang} />
      </div>
    </section>
  )}

  {kind === 'contact' && (
    <section class="section">
      <div class="container split">
        <div class="stack">
          <ul class="contact-list">
            <li><Icon name="whatsapp" /><div><b>{ar ? 'واتساب' : 'WhatsApp'}</b><a href={waLink(t.waHello)}>{SITE.whatsapp ? displayPhone(lang) : <span class="ph">{ar ? '[رقم الواتساب]' : '[WhatsApp number]'}</span>}</a></div></li>
            <li><Icon name="phone" /><div><b>{ar ? 'اتصال' : 'Phone'}</b><a href={telLink()} dir="ltr">{SITE.phone ? displayPhone(lang) : <span class="ph">{ar ? '[رقم الاتصال]' : '[Phone number]'}</span>}</a></div></li>
            <li><Icon name="mail" /><div><b>{ar ? 'الإيميل' : 'Email'}</b><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div></li>
            <li><Icon name="pin" /><div><b>{ar ? 'المحل' : 'Shop'}</b>{SITE.mapsUrl ? <a href={SITE.mapsUrl}>{ar ? SITE.shopAr : SITE.shopEn}</a> : <span>{ar ? SITE.shopAr : SITE.shopEn}</span>}</div></li>
            <li><Icon name="clock" /><div><b>{ar ? 'أوقات العمل' : 'Hours'}</b><span>{ar ? 'السبت إلى الخميس' : 'Saturday to Thursday'}, <span dir="ltr">{SITE.hours.opens}–{SITE.hours.closes}</span></span></div></li>
          </ul>
        </div>
        <div class="card"><h2 class="h3">{ar ? 'نموذج طلب الخدمة' : 'Service request form'}</h2><RequestForm lang={lang} /></div>
      </div>
    </section>
  )}

  {(kind === 'contracts' || kind === 'contact') && (
    <section class="section mist"><div class="container narrow"><h2 style="margin-bottom:20px">{ar ? 'أسئلة شائعة' : 'FAQ'}</h2><Blocks kind="faq" lang={lang} items={FAQ[lang]} /></div></section>
  )}

  {kind !== 'contact' && <Sections kind="cta" lang={lang} />}
</Base>
<style>
  .h3 { font-size: 1.3rem; }
  .h3 a { color: inherit; text-decoration: none; }
  .h3 a:hover { text-decoration: underline; }
  .contact-list { list-style: none; padding: 0; display: grid; gap: 14px; }
  .contact-list li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; }
  .contact-list :global(svg) { width: 24px; height: 24px; color: var(--cedar); flex-shrink: 0; margin-top: 3px; }
  .contact-list div { display: flex; flex-direction: column; }
</style>
